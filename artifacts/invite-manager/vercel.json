{
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist/public",
  "installCommand": "pnpm install --frozen-lockfile",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://gestion-des-invitations-pwa--shadowcoder322.replit.app/api/:path*"
    },
    {
      "source": "^/(?!api(?:/|$)|assets(?:/|$)|icons(?:/|$)|favicon\\.svg$|manifest\\.webmanifest$|service-worker\\.js$|robots\\.txt$)(.*)$",
      "destination": "/index.html"
    }
  ]
}
